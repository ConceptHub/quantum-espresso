! pw2wannier90 in library mode with noncollinear (spinor) projections:
! Wannier90 v4 spin-expands the projections block, so the 'sp3' line below gives
! 8 projections for num_wann = 8, one per Wannier function, the same convention
! the .nnkp file uses in wan_mode='standalone'.

num_bands = 8
num_wann  = 8
spinors   = .true.

num_iter         = 10
num_print_cycles = 10

begin projections
f = 0.0, 0.0, 0.0 : sp3
end projections

begin atoms_frac
 Si 0.00 0.00 0.00
 Si 0.25 0.25 0.25
end atoms_frac

begin unit_cell_cart
bohr
-5.1315510  0.00000 5.1315510
 0.00000  5.1315510 5.1315510
-5.1315510  5.1315510 0.00000
end unit_cell_cart

mp_grid = 2 2 2

begin kpoints
  0.00000000  0.00000000  0.00000000
  0.00000000  0.00000000  0.50000000
  0.00000000  0.50000000  0.00000000
  0.00000000  0.50000000  0.50000000
  0.50000000  0.00000000  0.00000000
  0.50000000  0.00000000  0.50000000
  0.50000000  0.50000000  0.00000000
  0.50000000  0.50000000  0.50000000
end kpoints
